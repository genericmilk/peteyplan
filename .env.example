# Copy to `.env` and adjust. All optional — defaults work out of the box.
# Port the app serves on (host side; container stays on 3000).
PORT=3000
# Folder holding your projects, mounted at the same path inside the container
# so linked Code-panel folders resolve. Only used by docker-compose.git.yml.
# Must be absolute; defaults to your home directory.
# CODE_DIR=/home/you/Projects
